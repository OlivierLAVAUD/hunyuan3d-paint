# Copy to .env and edit as needed: `cp .env.example .env`.
# H3D_* is read by app/config.py (the API), H3D_UI_* by ui/config.py (the Gradio
# front-end); docker-compose interpolates both.

# --- Service ---------------------------------------------------------------
H3D_HOST=0.0.0.0
# 8082, so this service sits next to the shape one (8081) rather than on it.
H3D_PORT=8082
H3D_LOG_LEVEL=info
# Comma-separated list; "*" allows every origin.
H3D_CORS_ORIGINS=*

# --- Storage (inside the container) ---------------------------------------
H3D_OUTPUT_DIR=/data/outputs
H3D_UPLOAD_DIR=/data/uploads
H3D_MODEL_CACHE_DIR=/data/models
# Reference images.
H3D_MAX_UPLOAD_MB=32
# Meshes: a decimated 50k-face STL is a few MB, a raw marching-cubes GLB can be
# 30-60 MB. Its own, larger ceiling.
H3D_MAX_MESH_UPLOAD_MB=256

# --- Hunyuan3D paint model -------------------------------------------------
H3D_MODEL_ID=tencent/Hunyuan3D-2
H3D_MODEL_SUBFOLDER=hunyuan3d-paint-v2-0-turbo
# auto | cuda | cuda:0. There is no cpu: the paint rasterizer is a CUDA
# extension with no CPU implementation, and `auto` on a GPU-less host fails.
H3D_DEVICE=auto
# 0 = load the ~7.5 GB of fp16 weights on the first request instead of during
#     startup (the download is ~14 GB: the repo ships each file both as an
#     fp32 .bin and as fp16 safetensors).
H3D_PRELOAD_MODEL=0
# 1 = the entrypoint pre-downloads the checkpoint before starting uvicorn.
H3D_DOWNLOAD_MODELS=1

# --- The two guards in front of the load ----------------------------------
# 1. Host RAM. The checkpoints are ~7.5 GB of fp16 weights (a ~14 GB download:
#    the repo ships each file both as an fp32 .bin and as fp16 safetensors)
#    and are read into *system* memory before anything reaches the GPU: below
#    this, the container is OOM-killed mid-load and the client only sees a
#    dropped connection.
#    The budget compared against it is *reachable* memory: free RAM plus free
#    swap, but only when the container is allowed to swap (H3D_MEMSWAP_LIMIT).
H3D_MIN_HOST_RAM_GB=14
# 2. VRAM. The harder of the two on a laptop: the full-resident set is ~8 GB
#    of fp16 weights (multiview ~5.3 + delight ~2.2 + renderer ~0.7) and does
#    not fit in a 6 GB card, however much system RAM the host has, and
#    lowering texture_size does not help because the *weights* have to fit.
#    Checked with nvidia-smi before the load starts. 0 disables the check.
H3D_MIN_VRAM_GB=9

# --- Low-VRAM mode: stream the weights instead of holding them -------------
# 1 = build the pipelines *CPU-first* and keep the checkpoint in *system* RAM,
#     moving it onto the card one sub-module at a time (sequential CPU
#     offload), instead of holding the whole ~8 GB resident. This is what
#     makes the service usable on a 6 GB GPU.
#
# The costs are real, so this is off by default:
#   * speed — every forward pass shuttles weights over PCIe, and a run
#     that takes ~2-3 minutes full-resident takes tens of minutes;
#   * host RAM — the checkpoint stays resident in system memory, so
#     H3D_MIN_HOST_RAM_GB still has to be satisfied.
#
# What has to fit in VRAM is no longer the whole model but the largest single
# sub-module, plus the renderer, the CUDA context and the activations. That
# is what H3D_MIN_VRAM_LOW_GB (below) enforces — not zero, and not derived
# from H3D_MIN_VRAM_GB, because the two modes have different resident sets.
H3D_LOW_VRAM=0
# VRAM the low-VRAM mode needs, in GB. Only one sub-module is resident, but
# the renderer, the CUDA context and the activations are not offloaded.
# 0 disables the check.
H3D_MIN_VRAM_LOW_GB=3

# --- Texture defaults ------------------------------------------------------
# Resolution of the baked UV atlas. The main VRAM knob at run time; upstream
# hardcodes 2048 and takes no resolution argument, so the engine pushes this
# onto the renderer before each paint call.
H3D_DEFAULT_TEXTURE_SIZE=768
H3D_MIN_TEXTURE_SIZE=256
H3D_MAX_TEXTURE_SIZE=2048
# Geometry preparation, applied before painting.
H3D_DEFAULT_TARGET_FACES=50000
H3D_DEFAULT_TAUBIN_STEPS=20
H3D_DEFAULT_TAUBIN_LAMBDA=0.5
H3D_DEFAULT_TAUBIN_MU=-0.53
# 1 = generate a UV atlas when the uploaded mesh has none. A marching-cubes mesh
# has no UVs, and the paint model's output *is* a texture atlas: without this,
# those meshes cannot be textured at all.
H3D_DEFAULT_UV_UNWRAP=1

# Multiview diffusion seed: a fixed value makes a texture reproducible;
# -1 draws a fresh seed for every job instead (the code default is 0, which
# is what upstream hardcoded before the vendored fork took a seed at all).
H3D_DEFAULT_SEED=12345

# --- Inputs ----------------------------------------------------------------
H3D_ALLOWED_MESH_SUFFIXES=.glb,.gltf,.obj,.ply,.stl
H3D_ALLOWED_IMAGE_SUFFIXES=.png,.jpg,.jpeg,.webp,.bmp

# --- Container memory ------------------------------------------------------
# Two cgroup knobs, and the gap between them is what decides whether the
# container may swap at all:
#   H3D_MEM_LIMIT     -> memory.max                      (RAM ceiling)
#   H3D_MEMSWAP_LIMIT -> memory.swap.max + memory.max     (RAM **plus** swap)
# Setting them equal sets memory.swap.max=0, i.e. disables swapping, and the
# ~14 GB paint load then dies at the RAM ceiling with 16 GB of idle swap right
# next to it. That is exactly what killed the first textured run of the sister
# project, so keep the swap limit comfortably above the RAM limit.
H3D_MEM_LIMIT=15g
H3D_MEMSWAP_LIMIT=31g
# glibc arena count. WSL2's default is 1 (4.2 MiB of virtual address grace per
# extension), which is tight for torch's many small allocations.
MALLOC_ARENA_MAX=2

# --- Concurrency -----------------------------------------------------------
# There is one GPU: raise this only if it is shared between instances.
H3D_MAX_CONCURRENT_JOBS=1

# --- Gradio front-end (ui/config.py) ---------------------------------------
# Where the API lives. Inside compose this is the service name; for a remote
# GPU box, use its host:port.
H3D_UI_API_URL=http://hunyuan3d-paint-api:8082
# 7861, so it sits next to the shape service's page (7860) rather than on it.
H3D_UI_PORT=7861
# Must outlast a paint run (~2-3 min at 768 px, longer at 2048).
H3D_UI_TIMEOUT_S=1800
# Downloaded artifacts, so the viewers and download links do not depend on the
# browser being able to reach the API.
H3D_UI_DATA_DIR=/data/ui

# --- Docker build args -----------------------------------------------------
# Torch wheel index; must match the host driver (cu130 needs driver >= 580).
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu130
TORCH_VERSION=2.14.0
TORCHVISION_VERSION=0.29.0
# The paint model's two extensions are compiled with the CUDA toolkit of this
# devel image; keep the minor version on par with the wheels above.
CUDA_VERSION=13.0.2
# Architectures to compile those extensions for. No GPU is visible during the
# build, so PyTorch cannot detect one: list your card(s) - 8.6 = RTX 30xx,
# 8.9 = 40xx, 12.0 = 50xx. Each added target lengthens the build.
TORCH_CUDA_ARCH_LIST=8.6;8.9;12.0
